+/* Task watchdog record structure */
+typedef struct {
+    TaskHandle_t task_handle;
+    char task_name[32];
+    watchdog_mode_t mode;
+    bool twdt_subscribed;
+    TickType_t last_heartbeat;
+    TickType_t last_check;
+    bool registration_pending;
+    esp_err_t last_error;
+} task_watchdog_record_t;
+
+/* Static registry */
+static task_watchdog_record_t s_records[TASK_WATCHDOG_MAX_TASKS];
+static int s_num_records = 0;
+static SemaphoreHandle_t s_registry_mutex = NULL;
+static bool s_initialized = false;
+static TickType_t s_health_timeout_ms = TASK_WATCHDOG_DEFAULT_TIMEOUT_MS;
+
+/* Forward declarations */
+static task_watchdog_record_t* find_record(TaskHandle_t task);
+static task_watchdog_record_t* find_record_by_name(const char* name);
+static int find_empty_slot(void);
+static esp_err_t verify_twdt_subscription(TaskHandle_t task);
+static void log_registry_status(void);
+
+/* ============================================================ */
+/* Initialization */
+/* ============================================================ */
+
+esp_err_t task_watchdog_init(void) {
+    if (s_initialized) {
+        return ESP_OK;
+    }
+
+    /* Create mutex for registry protection */
+    s_registry_mutex = xSemaphoreCreateMutex();
+    if (s_registry_mutex == NULL) {
+        ESP_LOGE(TAG, "Failed to create registry mutex");
+        return ESP_ERR_NO_MEM;
+    }
+
+    /* Clear registry */
+    memset(s_records, 0, sizeof(s_records));
+    s_num_records = 0;
+
+    s_initialized = true;
+    ESP_LOGI(TAG, "Task watchdog registry initialized");
+    return ESP_OK;
+}
+
+/* ============================================================ */
+/* Registration */
+/* ============================================================ */
+
+esp_err_t task_watchdog_register(TaskHandle_t task, const char* name, watchdog_mode_t mode) {
+    if (!s_initialized) {
+        ESP_LOGE(TAG, "Watchdog not initialized");
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    if (task == NULL || name == NULL) {
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    if (mode == WATCHDOG_MODE_NONE) {
+        ESP_LOGW(TAG, "Attempted to register %s with NONE mode", name);
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    xSemaphoreTake(s_registry_mutex, portMAX_DELAY);
+
+    /* Check if task already registered */
+    task_watchdog_record_t* existing = find_record(task);
+    if (existing != NULL) {
+        ESP_LOGW(TAG, "Task %s already registered (mode=%d)", existing->task_name, existing->mode);
+        xSemaphoreGive(s_registry_mutex);
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    /* Find empty slot */
+    int slot = find_empty_slot();
+    if (slot < 0) {
+        ESP_LOGE(TAG, "No free slots for task %s (max %d)", name, TASK_WATCHDOG_MAX_TASKS);
+        xSemaphoreGive(s_registry_mutex);
+        return ESP_ERR_NO_MEM;
+    }
+
+    task_watchdog_record_t* record = &s_records[slot];
+    record->task_handle = task;
+    strncpy(record->task_name, name, sizeof(record->task_name) - 1);
+    record->task_name[sizeof(record->task_name) - 1] = '\0';
+    record->mode = mode;
+    record->twdt_subscribed = false;
+    record->last_heartbeat = xTaskGetTickCount();
+    record->last_check = xTaskGetTickCount();
+    record->registration_pending = true;
+    record->last_error = ESP_OK;
+    s_num_records++;
+
+    /* Register with TWDT if requested */
+    esp_err_t err = ESP_OK;
+    if (mode == WATCHDOG_MODE_TWDT || mode == WATCHDOG_MODE_BOTH) {
+        err = esp_task_wdt_add(task);
+        if (err == ESP_OK) {
+            record->twdt_subscribed = true;
+            ESP_LOGI(TAG, "TWDT subscribed: %s", name);
+        } else if (err == ESP_ERR_INVALID_STATE) {
+            /* Task might already be in TWDT - verify */
+            ESP_LOGW(TAG, "TWDT add returned ESP_ERR_INVALID_STATE for %s - verifying", name);
+            err = verify_twdt_subscription(task);
+            if (err == ESP_OK) {
+                record->twdt_subscribed = true;
+                ESP_LOGI(TAG, "TWDT already subscribed: %s", name);
+            } else {
+                ESP_LOGE(TAG, "TWDT subscription verification failed for %s: %s", name, esp_err_to_name(err));
+                record->twdt_subscribed = false;
+                record->mode = WATCHDOG_MODE_HEALTH_ONLY;
+            }
+        } else {
+            ESP_LOGE(TAG, "TWDT add failed for %s: %s", name, esp_err_to_name(err));
+            record->twdt_subscribed = false;
+            record->mode = WATCHDOG_MODE_HEALTH_ONLY;
+        }
+        record->last_error = err;
+    }
+
+    record->registration_pending = false;
+
+    xSemaphoreGive(s_registry_mutex);
+
+    ESP_LOGI(TAG, "Registered task %s (mode=%d, twdt=%d)", name, mode, record->twdt_subscribed);
+    return err;
+}
+
+esp_err_t task_watchdog_unregister(TaskHandle_t task) {
+    if (!s_initialized) {
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    if (task == NULL) {
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    xSemaphoreTake(s_registry_mutex, portMAX_DELAY);
+
+    task_watchdog_record_t* record = find_record(task);
+    if (record == NULL) {
+        ESP_LOGW(TAG, "Task not found for unregistration");
+        xSemaphoreGive(s_registry_mutex);
+        return ESP_ERR_NOT_FOUND;
+    }
+
+    /* Unsubscribe from TWDT if subscribed */
+    if (record->twdt_subscribed) {
+        esp_err_t err = esp_task_wdt_delete(task);
+        if (err != ESP_OK && err != ESP_ERR_NOT_FOUND) {
+            ESP_LOGW(TAG, "TWDT delete failed for %s: %s", record->task_name, esp_err_to_name(err));
+        }
+        record->twdt_subscribed = false;
+    }
+
+    /* Clear record */
+    memset(record, 0, sizeof(task_watchdog_record_t));
+    s_num_records--;
+
+    xSemaphoreGive(s_registry_mutex);
+
+    ESP_LOGI(TAG, "Unregistered task %s", record->task_name);
+    return ESP_OK;
+}
+
+/* ============================================================ */
+/* Feeding */
+/* ============================================================ */
+
+esp_err_t task_watchdog_feed_current_task(void) {
+    if (!s_initialized) {
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    TaskHandle_t current = xTaskGetCurrentTaskHandle();
+    if (current == NULL) {
+        return ESP_ERR_NOT_FOUND;
+    }
+
+    xSemaphoreTake(s_registry_mutex, portMAX_DELAY);
+
+    task_watchdog_record_t* record = find_record(current);
+    if (record == NULL) {
+        ESP_LOGW(TAG, "Current task %s not registered with watchdog", pcTaskGetName(current));
+        xSemaphoreGive(s_registry_mutex);
+        return ESP_ERR_NOT_FOUND;
+    }
+
+    esp_err_t final_err = ESP_OK;
+
+    /* Feed TWDT if in mode that includes TWDT */
+    if (record->mode == WATCHDOG_MODE_TWDT || record->mode == WATCHDOG_MODE_BOTH) {
+        if (record->twdt_subscribed) {
+            esp_err_t err = esp_task_wdt_reset();
+            if (err != ESP_OK) {
+                ESP_LOGE(TAG, "TWDT feed failed for %s: %s", record->task_name, esp_err_to_name(err));
+                final_err = err;
+            }
+        } else {
+            ESP_LOGW(TAG, "TWDT mode but not subscribed for %s", record->task_name);
+            final_err = ESP_ERR_INVALID_STATE;
+        }
+    }
+
+    /* Always update health heartbeat if health monitoring is active */
+    if (record->mode == WATCHDOG_MODE_HEALTH_ONLY || record->mode == WATCHDOG_MODE_BOTH) {
+        record->last_heartbeat = xTaskGetTickCount();
+    }
+
+    xSemaphoreGive(s_registry_mutex);
+    return final_err;
+}
+
+esp_err_t task_watchdog_feed_task(TaskHandle_t task) {
+    if (!s_initialized) {
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    if (task == NULL) {
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    xSemaphoreTake(s_registry_mutex, portMAX_DELAY);
+
+    task_watchdog_record_t* record = find_record(task);
+    if (record == NULL) {
+        xSemaphoreGive(s_registry_mutex);
+        return ESP_ERR_NOT_FOUND;
+    }
+
+    esp_err_t final_err = ESP_OK;
+
+    /* Feed TWDT if in mode that includes TWDT */
+    if (record->mode == WATCHDOG_MODE_TWDT || record->mode == WATCHDOG_MODE_BOTH) {
+        if (record->twdt_subscribed) {
+            esp_err_t err = esp_task_wdt_reset();
+            if (err != ESP_OK) {
+                ESP_LOGE(TAG, "TWDT feed failed for %s: %s", record->task_name, esp_err_to_name(err));
+                final_err = err;
+            }
+        } else {
+            final_err = ESP_ERR_INVALID_STATE;
+        }
+    }
+
+    /* Always update health heartbeat if health monitoring is active */
+    if (record->mode == WATCHDOG_MODE_HEALTH_ONLY || record->mode == WATCHDOG_MODE_BOTH) {
+        record->last_heartbeat = xTaskGetTickCount();
+    }
+
+    xSemaphoreGive(s_registry_mutex);
+    return final_err;
+}
+
+esp_err_t task_watchdog_feed_health_only(void) {
+    if (!s_initialized) {
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    TaskHandle_t current = xTaskGetCurrentTaskHandle();
+    if (current == NULL) {
+        return ESP_ERR_NOT_FOUND;
+    }
+
+    xSemaphoreTake(s_registry_mutex, portMAX_DELAY);
+
+    task_watchdog_record_t* record = find_record(current);
+    if (record == NULL) {
+        ESP_LOGW(TAG, "Current task %s not registered for health monitoring", pcTaskGetName(current));
+        xSemaphoreGive(s_registry_mutex);
+        return ESP_ERR_NOT_FOUND;
+    }
+
+    /* Only update health if in health mode */
+    if (record->mode == WATCHDOG_MODE_HEALTH_ONLY || record->mode == WATCHDOG_MODE_BOTH) {
+        record->last_heartbeat = xTaskGetTickCount();
+        xSemaphoreGive(s_registry_mutex);
+        return ESP_OK;
+    }
+
+    ESP_LOGW(TAG, "Task %s is not health-monitored", record->task_name);
+    xSemaphoreGive(s_registry_mutex);
+    return ESP_ERR_INVALID_STATE;
 }
 

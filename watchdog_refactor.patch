-// task_watchdog.c - Original
+// task_watchdog.c - Refactored
 
 #include "task_watchdog.h"
 #include "esp_log.h"
 #include "esp_task_wdt.h"
+#include "esp_err.h"
+#include "freertos/FreeRTOS.h"

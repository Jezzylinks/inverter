-bool task_watchdog_is_registered(TaskHandle_t task) {
-    // ... existing code
+static esp_err_t verify_twdt_subscription(TaskHandle_t task) {
+    /* Try to feed the watchdog - if it returns OK, we're subscribed */
+    esp_err_t err = esp_task_wdt_reset();
+    if (err == ESP_OK) {
+        return ESP_OK;
+    }
+    
+    /* If we get NOT_FOUND or INVALID_STATE, we're not subscribed */
+    if (err == ESP_ERR_NOT_FOUND || err == ESP_ERR_INVALID_STATE) {
+        return ESP_ERR_NOT_FOUND;
+    }
+    
+    /* Other errors mean something else went wrong */
+    return err;
